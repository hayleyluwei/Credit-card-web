// Credit Card MVP - Prisma Schema
// Version: 2026-07-30 / v6
// Product Spec: credit-card-mvp-spec-v11-2026-06-08
// Schema Spec: prisma-schema-spec-v6-2026-07-30.md
// Target: personal developer MVP, low-cost setup
// Database: SQLite for local MVP development
// v3 (T21): add RewardTier / Channel / RewardTierChannel; Offer gains tiers
//   relation + headlineRate/headlineSummary. Reconciled the drifted v2
//   spec-dir copy (missing T19 Card fields).
// v4 (T21 Phase 5b): remove the transitional flat reward columns from Offer
//   (rewardType/rewardValue/rewardCap/minSpend/conditions) now that all data,
//   frontend, admin, and import paths use RewardTier.
// v5 (T23): add optional card-art colour columns to Card so the generated
//   card face can carry each card's real colour impression instead of a
//   slug-hashed palette entry. All nullable; blank falls back to the hash.
// v6 (T20): add Article model for guide articles (/guides, /guides/[slug]).
//   Scenario-tag config for /scenarios/[slug] stays in code, not a table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Site-wide settings used by the frontend and admin defaults.
model SiteSetting {
  id                    Int      @id @default(autoincrement())
  siteName              String   @default("信用卡優惠查詢")
  defaultSeoTitle       String?
  defaultSeoDescription String?
  homepageFeaturedCount Int      @default(6)
  categoryPageSize      Int      @default(12)
  showExpiredOffers     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Admin account for the MVP back office.
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

/// Bank issuer data used for filtering, card ownership, and bank pages.
model Bank {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  logoUrl        String?
  logoAlt        String?
  websiteUrl     String?
  description    String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cards Card[]

  @@index([isActive])
}

/// Credit card data. Offers are attached through OfferCard.
model Card {
  id              Int     @id @default(autoincrement())
  bankId          Int
  name            String
  slug            String  @unique
  imageUrl        String?
  imageAlt        String?
  summary         String?
  description     String?
  targetAudience  String?
  annualFee       String?
  annualFeeWaiver String?
  cardLevel       String?
  cardNetwork     String?

  // [T23] 卡面示意圖配色。取自官網卡面的整體色彩印象（不重製 Logo 或專屬構圖）。
  // 全部可選：留空時前台自動回退為依卡片 slug 雜湊產生的預設色。
  cardBgColorFrom   String?
  cardBgColorTo     String?
  cardTextColor     String?
  cardChipColorFrom String?
  cardChipColorTo   String?

  prosJson       String?
  consJson       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bank   Bank        @relation(fields: [bankId], references: [id], onDelete: Restrict)
  offers OfferCard[]

  @@index([bankId])
  @@index([isActive])
}

/// Frontend offer category, including SEO and FAQ metadata.
model Category {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  iconName       String?
  description    String?
  seoTitle       String?
  seoDescription String?
  faqJson        String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  offers Offer[]

  @@index([isActive, sortOrder])
}

/// Main credit-card offer content shown on listing and detail pages.
model Offer {
  id             Int     @id @default(autoincrement())
  categoryId     Int
  title          String
  slug           String  @unique
  summary        String?
  summaryMode    String  @default("system")
  targetAudience String?
  highlight1     String?
  highlight2     String?
  manualSummary  String?
  summaryPreview String?
  description    String?

  startDate DateTime?
  endDate   DateTime?

  // [T21 Phase 5b] 舊的扁平回饋欄位已移除，回饋一律由 RewardTier 承載。
  sourceUrl      String?
  lastVerifiedAt DateTime?
  tags           String?

  // [T21] 非正規化摘要欄位，供列表頁快速顯示，不必展開全部 tier。
  headlineRate    String?
  headlineSummary String?

  seoTitle       String?
  seoDescription String?
  faqJson        String?

  isFeatured     Boolean @default(false)
  recommendScore Int     @default(0)
  sortOrder      Int     @default(0)
  isPublished    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cards    OfferCard[]
  tiers    RewardTier[]

  @@index([categoryId])
  @@index([isPublished, isFeatured, recommendScore, sortOrder, updatedAt])
  @@index([endDate])
}

/// Join table for the many-to-many relation between offers and cards.
model OfferCard {
  offerId Int
  cardId  Int

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([offerId, cardId])
  @@index([cardId])
}

/// [T21] One reward layer within an offer. An offer has one or more tiers,
/// each with its own rate, cap, cap period, channels, and conditions.
model RewardTier {
  id             Int     @id @default(autoincrement())
  offerId        Int
  label          String?
  rewardType     String?
  rate           String?
  cap            String?
  capPeriod      String?
  minSpend       String?
  conditionsText String?
  /// JSON string (TierConditions). Populated but not consumed in early phase.
  conditions     String?
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer    Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  channels RewardTierChannel[]

  @@index([offerId])
}

/// [T21] Spending channel (e.g. a merchant category or platform) that a
/// reward tier applies to. Independent table, many-to-many with RewardTier.
model Channel {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers RewardTierChannel[]
}

/// [T21] Join table for the many-to-many relation between reward tiers and channels.
model RewardTierChannel {
  rewardTierId Int
  channelId    Int

  rewardTier RewardTier @relation(fields: [rewardTierId], references: [id], onDelete: Cascade)
  channel    Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([rewardTierId, channelId])
  @@index([channelId])
}

/// [T20] Guide article (long-form scenario content), rendered from Markdown.
model Article {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  summary        String?
  contentMd      String
  seoTitle       String?
  seoDescription String?
  faqJson        String?
  lastVerifiedAt DateTime?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}
